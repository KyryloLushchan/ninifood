#!/bin/sh
# Проверка staged-изменений на секреты (gitleaks). Включается: git config core.hooksPath .githooks (делает `npm install` через prepare).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks не установлен — проверка секретов пропущена (brew install gitleaks)" >&2
  exit 0
fi
exec gitleaks git --staged --redact --no-banner --verbose
